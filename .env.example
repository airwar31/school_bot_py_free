# ==============================================================================
# School LMS Telegram Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Super Administrators (comma-separated Telegram user IDs)
FULL_ADMIN_IDS=8391219214

# Schedule Administrators (comma-separated Telegram user IDs)
SCHEDULE_ADMIN_IDS=1124990195

# VKontakte Integration (Optional - leave empty to disable)
VK_TOKEN=your_vk_service_or_community_token
VK_GROUP_ID=171068837

# Database Path (Default: data/bot.db)
DATABASE_PATH=data/bot.db

# Timezone (Default: Asia/Yekaterinburg)
TZ=Asia/Yekaterinburg
